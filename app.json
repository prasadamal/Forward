{
  "expo": {
    "name": "Forward",
    "slug": "forward",
    "scheme": "forward",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B0B12"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.prasadamal.forward"
    },
    "android": {
      "package": "com.prasadamal.forward",
      "allowBackup": false,
      "adaptiveIcon": {
        "backgroundColor": "#0B0B12",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.ACCESS_MEDIA_LOCATION",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-sqlite",
        {
          "useSQLCipher": true
        }
      ],
      [
        "expo-secure-store",
        {
          "faceIDPermission": "Forward uses Face ID to unlock your encrypted vault."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Forward uses Face ID to unlock your encrypted vault."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Forward lets you pick photos and videos to keep in your encrypted vault.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-share-intent",
        {
          "iosShareExtensionName": "ForwardShare",
          "iosActivationRules": {
            "NSExtensionActivationSupportsText": true,
            "NSExtensionActivationSupportsWebURLWithMaxCount": 1,
            "NSExtensionActivationSupportsWebPageWithMaxCount": 1,
            "NSExtensionActivationSupportsImageWithMaxCount": 10,
            "NSExtensionActivationSupportsMovieWithMaxCount": 5,
            "NSExtensionActivationSupportsFileWithMaxCount": 5
          },
          "androidIntentFilters": [
            "text/*",
            "image/*",
            "video/*",
            "*/*"
          ],
          "androidMultiIntentFilters": [
            "image/*",
            "video/*",
            "*/*"
          ],
          "androidMainActivityAttributes": {
            "android:launchMode": "singleTask"
          }
        }
      ],
      [
        "./plugins/withShareExtensionDisplayName",
        {
          "targetName": "ForwardShare",
          "displayName": "Forward"
        }
      ],
      "expo-video",
      "expo-font"
    ]
  }
}
